{
  "name": "koa-server-pro-cli",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node --import tsx/esm src/app.js",
    "dev": "chcp 65001 > nul && nodemon --exec tsx src/app.js",
    "dev:watch": "tsx watch src/app.js",
    "prod": "pm2 start src/app.js --name koa-server --interpreter tsx",
    "prod:stop": "pm2 stop koa-server",
    "prod:restart": "pm2 restart koa-server",
    "prod:reload": "pm2 reload koa-server",
    "prod:logs": "pm2 logs koa-server",
    "prod:status": "pm2 status",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "imports": {
    "#/*": "./src/*"
  },
  "dependencies": {
    "@koa/router": "^15.4.0",
    "@prisma/adapter-mariadb": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "dotenv": "^17.3.1",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.1.2",
    "koa-bodyparser": "^4.4.1",
    "koa-jwt": "^4.0.4",
    "koa2-cors": "^2.0.6",
    "koa2-swagger-ui": "^5.12.0",
    "mysql2": "^3.11.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "swagger-jsdoc": "^6.2.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/config": "^7.5.0",
    "@types/node": "^25.5.0",
    "nodemon": "^3.1.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "prisma": "^7.5.0",
    "tsx": "^4.19.0"
  }
}
